void setup(void) {
  Wire.begin();               // Start I2C communication
  u8g2.begin();               // Initialize the display
  Serial.begin(9600);         // For debugging, if needed

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_ncenB12_tr);
  u8g2.drawXBMP(0, 0, 128, 64, my_image);  // full screen
  u8g2.sendBuffer();
}

static int count = 0;

void loop(void) {
  if (count % 2 == 0)
  {
    u8g2.drawXBMP(0, 0, 128, 64, my_image);  // full screen
  }
  else
  {
    u8g2.drawXBMP(0, 0, 128, 64, my_image_2);  // full screen
  }
  count++;
  u8g2.sendBuffer();
}
